{
  "name": "code-gladiators",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Four AI models build the same thing, live. Each entry is tested in a real browser, and an AI judge picks the winner.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "check-models": "node --env-file=.env.local scripts/check-models.mts"
  },
  "dependencies": {
    "@agent-browser/sandbox": "^0.43.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/sandbox": "^3.9.1",
    "ai": "^7.0.157",
    "botid": "^1.5.12",
    "geist": "^1.8.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "workflow": "^5.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
