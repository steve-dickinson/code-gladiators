# Copy to .env.local. Never commit .env.local.

# --- You set this one ---------------------------------------------------------
# The key that unlocks live battles. Anyone with it can spend your AI credit.
# Generate one with: openssl rand -hex 16
ARENA_KEY=

# --- `vercel env pull` writes these ---------------------------------------------
# Authenticates AI Gateway, Sandbox and Blob. Expires after 12 hours locally:
# run `vercel env pull` again when requests start failing as unauthenticated.
VERCEL_OIDC_TOKEN=

# Added when you connect a Blob store to the project (Storage tab in Vercel).
BLOB_STORE_ID=

# --- Optional ------------------------------------------------------------------
# A Sandbox snapshot with the browser preinstalled, so each battle's sandbox boots in
# about a second instead of installing it. Without it, everything still works.
# AGENT_BROWSER_SNAPSHOT_ID=
